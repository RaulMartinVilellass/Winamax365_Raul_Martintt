<odoo>

  <!-- Vista LIST -->
  <record id="view_usuario_list" model="ir.ui.view">
    <field name="name">winamax_365.usuario.list</field>
    <field name="model">winamax_365.usuario</field>
    <field name="arch" type="xml">
      <list string="Lista de jugadores">
        <field name="nombreUsuario"/>
        <field name="apellidoUsuario"/>
        <field name="edadUsuario"/>
        <field name="saldoUsuario"/>
        <field name="autoexcluido"/>
      </list>
    </field>
  </record>

  <!-- Vista FORM -->
  <record id="view_usuario_form" model="ir.ui.view">
    <field name="name">winamax_365.usuario.form</field>
    <field name="model">winamax_365.usuario</field>
    <field name="arch" type="xml">
      <form string="Ficha del jugador">
        <sheet>
          <group>
            <field name="nombreUsuario"/>
            <field name="apellidoUsuario"/>
            <field name="edadUsuario"/>
            <field name="saldoUsuario"/>
            <field name="limiteDeposito"/>
            <field name="autoexcluido"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción -->
  <record id="action_usuario" model="ir.actions.act_window">
    <field name="name">JUGADORES</field>
    <field name="res_model">winamax_365.usuario</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_usuario_list"/>
  </record>

  <!-- Menús -->
  <menuitem id="menu_winamax_root" name="Winamax 365"/>
  <menuitem id="menu_jugadores" parent="menu_winamax_root"
            name="Jugadores" action="action_usuario"/>
</odoo>
