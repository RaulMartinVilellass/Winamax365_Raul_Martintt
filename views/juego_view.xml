<odoo>

  <!-- Vista LIST -->
  <record id="view_juego_list" model="ir.ui.view">
    <field name="name">winamax_365.juego.list</field>
    <field name="model">winamax_365.juego</field>
    <field name="arch" type="xml">
      <list string="Lista de juegos">
        <field name="nombreJuego"/>
        <field name="tipoJuego"/>
        <field name="multiplicadorMaximo"/>
        <field name="tieneBonus"/>
        <field name="tieneJackpot"/>
      </list>
    </field>
  </record>

  <!-- Vista FORM -->
  <record id="view_juego_form" model="ir.ui.view">
    <field name="name">winamax_365.juego.form</field>
    <field name="model">winamax_365.juego</field>
    <field name="arch" type="xml">
      <form string="Ficha del juego">
        <sheet>
          <group>
            <field name="nombreJuego"/>
            <field name="tipoJuego"/>
            <field name="multiplicadorMaximo"/>
            <field name="tieneBonus"/>
            <field name="tieneJackpot"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción -->
  <record id="action_juego" model="ir.actions.act_window">
    <field name="name">CASINO</field>
    <field name="res_model">winamax_365.juego</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_juego_list"/>
  </record>

  <!-- Menú -->
  <menuitem id="menu_juegos" parent="menu_winamax_root" name="Casino" action="action_juego"/>
</odoo>
