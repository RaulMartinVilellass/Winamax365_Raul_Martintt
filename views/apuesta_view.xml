<odoo>

  <!-- Vista LIST -->
  <record id="view_apuesta_list" model="ir.ui.view">
    <field name="name">winamax_365.apuesta.list</field>
    <field name="model">winamax_365.apuesta</field>
    <field name="arch" type="xml">
      <list string="Lista de apuestas">
        <field name="usuario_id"/>
        <field name="evento_id"/>
        <field name="importeApuesta"/>
        <field name="cuotaApuesta"/>
        <field name="gananciaApuesta"/>
        <field name="estadoApuesta"/>
      </list>
    </field>
  </record>

  <!-- Vista FORM -->
  <record id="view_apuesta_form" model="ir.ui.view">
    <field name="name">winamax_365.apuesta.form</field>
    <field name="model">winamax_365.apuesta</field>
    <field name="arch" type="xml">
      <form string="Ficha de la apuesta">
        <header>
          <button name="action_ganada" type="object" string="Ganada"
                  class="btn-primary" invisible="estadoApuesta != 'pendiente'"/>
          <button name="action_perdida" type="object" string="Perdida"
                  invisible="estadoApuesta != 'pendiente'"/>
          <field name="estadoApuesta" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="usuario_id"/>
            <field name="evento_id"/>
            <field name="importeApuesta"/>
            <field name="cuotaApuesta"/>
            <field name="gananciaApuesta"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción -->
  <record id="action_apuesta" model="ir.actions.act_window">
    <field name="name">APUESTAS</field>
    <field name="res_model">winamax_365.apuesta</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_apuesta_list"/>
  </record>

  <!-- Menú -->
  <menuitem id="menu_apuestas" parent="menu_winamax_root"
            name="Apuestas" action="action_apuesta"/>
</odoo>
